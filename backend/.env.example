# --- Database Configuration ---
DB_HOST=127.0.0.1
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# --- Application Configuration ---
# The main domain where the app is hosted (e.g., yourclient.com)
APP_DOMAIN=your_client_domain.com

# --- Email (Mailgun) Configuration ---
# The verified sending domain in Mailgun
MAILER_DOMAIN=mg.your_client_domain.com
# The email address that users will see as the sender
MAILER_FROM=noreply@your_client_domain.com
# SMTP credentials provided by Mailgun
MAILGUN_SMTP_LOGIN=postmaster@mg.your_client_domain.com
MAILGUN_SMTP_PASSWORD=your_mailgun_password
