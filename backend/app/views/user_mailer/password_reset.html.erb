<div style="font-family: sans-serif; color: #4A6B10; max-width: 600px; margin: 0 auto; padding: 20px;">
  <h1 style="color: #426500;">Kem Bơ Password Reset</h1>
  <p>Hello <%= @user.first_name %>,</p>
  <p>You recently requested to reset your password for your Kem Bơ account. Click the button below to set a new password:</p>
  
  <% frontend_url = ENV.fetch('APP_DOMAIN', 'http://localhost:5173') %>
  <% frontend_url = "https://#{frontend_url}" unless frontend_url.start_with?('http') %>
  <% reset_link = "#{frontend_url}/reset-password?token=#{@user.reset_password_token}&email=#{CGI.escape(@user.email)}" %>

  <div style="text-align: center; margin: 30px 0;">
    <a href="<%= reset_link %>" style="background-color: #4d7902; color: white; padding: 15px 30px; text-decoration: none; border-radius: 50px; font-weight: bold; display: inline-block; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
      Reset My Password
    </a>
  </div>

  <p>This link will securely expire in 2 hours.</p>
  <p style="font-size: 14px; color: #63665e;">If you did not request a password reset, no further action is required and you can safely ignore this email.</p>
  <hr style="border: none; border-top: 1px solid #E3E5D7; margin: 30px 0;">
  <p style="font-size: 12px; color: #888;">Kem Bơ - Traditional Atelier & Smoothie Bar</p>
</div>
